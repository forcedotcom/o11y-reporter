{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["es2022", "dom"],
    "module": "node16",
    "moduleResolution": "Node16",
    "esModuleInterop": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["jest", "node"],
    "declaration": true,
    "declarationMap": true,
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types",
      "./node_modules/@salesforce/o11y-service/dist"
    ]
  },
  "include": ["src/**/*.ts", "src/types/o11y.d.ts"],
  "exclude": ["node_modules", "dist"]
}
